/* =========================================================
   WEBSITE AUDIT AGENT
========================================================= */

app.post("/api/ai/audit", async (req, res) => {
  try {
    const url = String(req.body.url || "").trim();

    if (!url) {
      return res.status(400).json({
        error: "Website URL required."
      });
    }

    const technicalAudit =
      await auditWebsite(url);

    const output = await askAI(
      "NEXORA Website Audit Agent",
      `
Use the technical audit data provided.

Create a professional modernization report with:
- Executive summary
- Strengths
- Problems
- Mobile and UX observations based only on available evidence
- SEO observations
- Conversion opportunities
- AI and automation opportunities
- Recommended NEXORA service package

Do not claim to have visually inspected anything that is not present in the data.
      `,
      JSON.stringify(
        technicalAudit,
        null,
        2
      )
    );

    res.json({
      technicalAudit,
      aiReport: output
    });

  } catch (error) {
    res.status(500).json({
      error: error.message
    });
  }
});

