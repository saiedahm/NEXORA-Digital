/* =========================================================
   PAYMENT CONFIRMATION

   Production:
   Connect Stripe/PayPal/bank provider webhook here.
========================================================= */

app.post("/api/invoices/:id/mark-paid", (req, res) => {
  const invoice = one(
    `
    SELECT *
    FROM invoices
    WHERE id=?
    `,
    req.params.id
  );

  if (!invoice) {
    return res.status(404).json({
      error: "Invoice not found."
    });
  }

  run(
    `
    UPDATE invoices
    SET status='PAID',
    paid_at=?
    WHERE id=?
    `,
    now(),
    invoice.id
  );

  if (invoice.project_id) {
    run(
      `
      UPDATE projects
      SET status='IN_PROGRESS',
      updated_at=?
      WHERE id=?
      `,
      now(),
      invoice.project_id
    );
  }

  addActivity(
    "PAYMENT",
    `Payment confirmed for ${invoice.invoice_number}`
  );

  res.json({
    success: true,
    message:
      "Payment confirmed. Project workflow can continue."
  });
});

