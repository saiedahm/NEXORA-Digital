 require("dotenv").config();

const express = require("express");
const Database = require("better-sqlite3");
const crypto = require("crypto");
const OpenAI = require("openai");

const app = express();

const PORT = process.env.PORT || 3000;
const MODEL = process.env.OPENAI_MODEL || "gpt-5.6-luna";

const ai = process.env.OPENAI_API_KEY
  ? new OpenAI({ apiKey: process.env.OPENAI_API_KEY })
  : null;

const db = new Database("nexora.db");

app.use(express.json({ limit: "2mb" }));

/* =========================================================
   DATABASE
========================================================= */

db.exec(`
CREATE TABLE IF NOT EXISTS clients (
  id TEXT PRIMARY KEY,
  name TEXT,
  company TEXT,
  email TEXT,
  phone TEXT,
  website TEXT,
  country TEXT,
  industry TEXT,
  status TEXT DEFAULT 'NEW',
  score INTEGER DEFAULT 50,
  notes TEXT,
  created_at TEXT
);

CREATE TABLE IF NOT EXISTS projects (
  id TEXT PRIMARY KEY,
  client_id TEXT,
  title TEXT,
  service TEXT,
  budget TEXT,
  status TEXT DEFAULT 'PLANNING',
  priority TEXT DEFAULT 'NORMAL',
  description TEXT,
  created_at TEXT,
  updated_at TEXT
);

CREATE TABLE IF NOT EXISTS quotes (
  id TEXT PRIMARY KEY,
  client_id TEXT,
  project_id TEXT,
  title TEXT,
  amount REAL,
  currency TEXT DEFAULT 'EUR',
  description TEXT,
  status TEXT DEFAULT 'DRAFT',
  created_at TEXT
);

CREATE TABLE IF NOT EXISTS invoices (
  id TEXT PRIMARY KEY,
  client_id TEXT,
  project_id TEXT,
  quote_id TEXT,
  invoice_number TEXT,
  amount REAL,
  currency TEXT DEFAULT 'EUR',
  status TEXT DEFAULT 'PENDING',
  created_at TEXT,
  paid_at TEXT
);

CREATE TABLE IF NOT EXISTS approvals (
  id TEXT PRIMARY KEY,
  client_id TEXT,
  project_id TEXT,
  title TEXT,
  design_url TEXT,
  notes TEXT,
  status TEXT DEFAULT 'PENDING',
  created_at TEXT,
  approved_at TEXT
);

CREATE TABLE IF NOT EXISTS activities (
  id TEXT PRIMARY KEY,
  type TEXT,
  message TEXT,
  created_at TEXT
);

CREATE TABLE IF NOT EXISTS ai_runs (
  id TEXT PRIMARY KEY,
  agent TEXT,
  input TEXT,
  output TEXT,
  created_at TEXT
);

CREATE TABLE IF NOT EXISTS portal_tokens (
  id TEXT PRIMARY KEY,
  client_id TEXT,
  token TEXT UNIQUE,
  created_at TEXT
);

CREATE TABLE IF NOT EXISTS settings (
  key TEXT PRIMARY KEY,
  value TEXT
);
`);

function now() {
  return new Date().toISOString();
}

function id() {
  return crypto.randomUUID();
}

function addActivity(type, message) {
  db.prepare(`
    INSERT INTO activities
    VALUES (?, ?, ?, ?)
  `).run(id(), type, message, now());
}

function one(sql, ...params) {
  return db.prepare(sql).get(...params);
}

function all(sql, ...params) {
  return db.prepare(sql).all(...params);
}

function run(sql, ...params) {
  return db.prepare(sql).run(...params);
}

/* =========================================================
   AI
========================================================= */

async function askAI(agent, instructions, input) {
  let output = "";

  if (!ai) {
    output = `
DEMO MODE

${agent} received the task successfully.

Input:
${input}

To activate real AI:
1. Create an API key.
2. Add OPENAI_API_KEY to .env
3. Restart the server.
`;
  } else {
    const response = await ai.responses.create({
      model: MODEL,
      instructions: `
You are ${agent}, working inside NEXORA Digital.

${instructions}

Rules:
- Be accurate.
- Do not invent facts.
- Clearly mark assumptions.
- Do not claim that an email, payment, contract, or external action happened unless the system explicitly confirms it.
- Keep output structured and useful.
- Human approval is required before irreversible or external business actions.
`,
      input
    });

    output =
      response.output_text ||
      "The AI completed the task but returned no text.";
  }

  run(
    `
    INSERT INTO ai_runs
    VALUES (?, ?, ?, ?, ?)
    `,
    id(),
    agent,
    input,
    output,
    now()
  );

  addActivity("AI", `${agent} completed a task.`);

  return output;
}

/* =========================================================
   WEBSITE AUDIT
========================================================= */

async function auditWebsite(url) {
  let result = {
    url,
    reachable: false,
    status: null,
    title: "",
    description: "",
    hasViewport: false,
    hasLang: false,
    hasOpenGraph: false,
    forms: 0,
    images: 0,
    links: 0,
    issues: [],
    recommendations: []
  };

  try {
    if (!/^https?:\/\//i.test(url)) {
      url = "https://" + url;
      result.url = url;
    }

    const controller = new AbortController();

    const timer = setTimeout(
      () => controller.abort(),
      12000
    );

    const response = await fetch(url, {
      signal: controller.signal,
      redirect: "follow",
      headers: {
        "User-Agent":
          "NEXORA-Digital-Audit/1.0"
      }
    });

    clearTimeout(timer);

    const html = await response.text();

    result.reachable = true;
    result.status = response.status;

    const title =
      html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);

    const description =
      html.match(
        /<meta[^>]+name=["']description["'][^>]+content=["']([^"']*)/i
      );

    result.title =
      title ? title[1].trim() : "";

    result.description =
      description ? description[1].trim() : "";

    result.hasViewport =
      /name=["']viewport["']/i.test(html);

    result.hasLang =
      /<html[^>]+lang=/i.test(html);

    result.hasOpenGraph =
      /property=["']og:/i.test(html);

    result.forms =
      (html.match(/<form\b/gi) || []).length;

    result.images =
      (html.match(/<img\b/gi) || []).length;

    result.links =
      (html.match(/<a\b/gi) || []).length;

    if (!result.title) {
      result.issues.push(
        "No page title was detected."
      );
    }

    if (!result.description) {
      result.issues.push(
        "No meta description was detected."
      );
    }

    if (!result.hasViewport) {
      result.issues.push(
        "Mobile viewport tag was not detected."
      );
    }

    if (!result.hasLang) {
      result.issues.push(
        "HTML language attribute was not detected."
      );
    }

    if (!result.hasOpenGraph) {
      result.recommendations.push(
        "Add Open Graph metadata for better social sharing."
      );
    }

    result.recommendations.push(
      "Review performance with a dedicated performance testing service."
    );

    result.recommendations.push(
      "Review accessibility, mobile usability, SEO and conversion paths."
    );

    return result;

  } catch (error) {

    result.issues.push(
      "The website could not be analyzed: " +
      error.message
    );

    return result;
  }
}

/* =========================================================
   DASHBOARD
========================================================= */

app.get("/api/dashboard", (req, res) => {
  const data = {
    clients:
      one("SELECT COUNT(*) AS n FROM clients").n,

    projects:
      one("SELECT COUNT(*) AS n FROM projects").n,

    activeProjects:
      one(`
        SELECT COUNT(*) AS n
        FROM projects
        WHERE status IN ('DESIGN','IN_PROGRESS','QA')
      `).n,

    paidInvoices:
      one(`
        SELECT COUNT(*) AS n
        FROM invoices
        WHERE status='PAID'
      `).n,

    pendingApprovals:
      one(`
        SELECT COUNT(*) AS n
        FROM approvals
        WHERE status='PENDING'
      `).n,

    activities:
      all(`
        SELECT *
        FROM activities
        ORDER BY created_at DESC
        LIMIT 20
      `),

    recentAI:
      all(`
        SELECT *
        FROM ai_runs
        ORDER BY created_at DESC
        LIMIT 10
      `)
  };

  res.json(data);
});

/* =========================================================
   CLIENTS / CRM
========================================================= */

app.get("/api/clients", (req, res) => {
  res.json(
    all(`
      SELECT *
      FROM clients
      ORDER BY created_at DESC
    `)
  );
});

app.post("/api/clients", (req, res) => {
  const c = req.body;

  const client = {
    id: id(),
    name: c.name || "",
    company: c.company || "",
    email: c.email || "",
    phone: c.phone || "",
    website: c.website || "",
    country: c.country || "Germany",
    industry: c.industry || "",
    status: c.status || "NEW",
    score: Number(c.score || 50),
    notes: c.notes || "",
    created_at: now()
  };

  run(`
    INSERT INTO clients VALUES
    (
      @id,
      @name,
      @company,
      @email,
      @phone,
      @website,
      @country,
      @industry,
      @status,
      @score,
      @notes,
      @created_at
    )
  `, client);

  addActivity(
    "CRM",
    `New client added: ${client.company || client.name}`
  );

  res.status(201).json(client);
});

app.delete("/api/clients/:id", (req, res) => {
  run(
    "DELETE FROM clients WHERE id=?",
    req.params.id
  );

  addActivity(
    "CRM",
    "Client deleted."
  );

  res.json({ success: true });
});

/* =========================================================
   PROJECTS
========================================================= */

app.get("/api/projects", (req, res) => {
  res.json(
    all(`
      SELECT projects.*,
      clients.company AS client_company,
      clients.name AS client_name
      FROM projects
      LEFT JOIN clients
      ON projects.client_id = clients.id
      ORDER BY projects.created_at DESC
    `)
  );
});

app.post("/api/projects", (req, res) => {
  const p = req.body;

  const project = {
    id: id(),
    client_id: p.client_id || "",
    title: p.title || "NEXORA Project",
    service: p.service || "Website Development",
    budget: p.budget || "",
    status: p.status || "PLANNING",
    priority: p.priority || "NORMAL",
    description: p.description || "",
    created_at: now(),
    updated_at: now()
  };

  run(`
    INSERT INTO projects VALUES
    (
      @id,
      @client_id,
      @title,
      @service,
      @budget,
      @status,
      @priority,
      @description,
      @created_at,
      @updated_at
    )
  `, project);

  addActivity(
    "PROJECT",
    `Project created: ${project.title}`
  );

  res.status(201).json(project);
});

app.put("/api/projects/:id", (req, res) => {
  const old = one(
    "SELECT * FROM projects WHERE id=?",
    req.params.id
  );

  if (!old) {
    return res.status(404).json({
      error: "Project not found."
    });
  }

  const p = {
    ...old,
    ...req.body,
    updated_at: now()
  };

  run(`
    UPDATE projects SET
      client_id=@client_id,
      title=@title,
      service=@service,
      budget=@budget,
      status=@status,
      priority=@priority,
      description=@description,
      updated_at=@updated_at
    WHERE id=@id
  `, p);

  addActivity(
    "PROJECT",
    `Project updated: ${p.title}`
  );

  res.json(p);
});

/* =========================================================
   AI MANAGER
========================================================= */

app.post("/api/ai/manager", async (req, res) => {
  try {
    const task = String(req.body.task || "").trim();

    if (!task) {
      return res.status(400).json({
        error: "Please enter a task."
      });
    }

    const output = await askAI(
      "NEXORA AI Manager",
      `
You coordinate the NEXORA digital agency.

Classify the task into:
1. Lead Research
2. Website Audit
3. Design
4. Quote
5. Project Planning
6. Development
7. QA
8. Launch

Return:
- Selected workflow
- Recommended next action
- Risks
- What requires human approval
      `,
      task
    );

    res.json({ output });

  } catch (error) {
    res.status(500).json({
      error: error.message
    });
  }
});

